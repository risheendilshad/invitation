<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Risheen weds Dilshad | 5 January 2027</title>
<meta name="description" content="You are invited to the wedding of Risheen and Dilshad on 5 January 2027 at Rajah Hall, Chavakkad.">
<meta name="theme-color" content="#062b28">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Italiana&family=Jost:wght@300;400;500&family=Pinyon+Script&display=swap" rel="stylesheet">
<style>
:root{
  --ink:#062b28;
  --deep:#0a413c;
  --teal:#11615a;
  --gold:#d4af5f;
  --gold2:#f2dc9b;
  --blush:#f3d6cc;
  --ivory:#fbf2e6;
  --script:"Pinyon Script","Snell Roundhand",cursive;
  --display:"Italiana","Didot",serif;
  --body:"Jost","Helvetica Neue",sans-serif;
}
*{box-sizing:border-box;margin:0;padding:0}
html{scroll-behavior:smooth}
body{
  background:var(--ink);
  color:var(--ivory);
  font-family:var(--body);
  font-weight:300;
  line-height:1.7;
  overflow-x:hidden;
  -webkit-font-smoothing:antialiased;
}
body.locked{height:100vh;overflow:hidden}
a{color:inherit}
:focus-visible{outline:2px solid var(--gold2);outline-offset:4px}

/* ============ INTRO ENVELOPE ============ */
#intro{
  position:fixed;inset:0;z-index:100;
  display:grid;place-items:center;
  background:
    radial-gradient(ellipse at 50% 40%,#0f524b 0%,#062b28 70%);
  transition:opacity 1.2s ease,transform 1.6s cubic-bezier(.6,0,.2,1),visibility 0s 1.6s;
}
#intro.done{opacity:0;transform:scale(1.35);visibility:hidden;pointer-events:none}
#intro .glow{
  position:absolute;width:70vmin;height:70vmin;border-radius:50%;
  background:radial-gradient(circle,rgba(212,175,95,.25),transparent 65%);
  animation:breathe 4s ease-in-out infinite;
}
@keyframes breathe{50%{transform:scale(1.2);opacity:.6}}
.env-wrap{position:relative;display:grid;justify-items:center;gap:3.2rem}
.env{
  position:relative;
  width:min(84vw,380px);aspect-ratio:3/2;
  perspective:1200px;
  animation:float 4.5s ease-in-out infinite;
}
@keyframes float{50%{transform:translateY(-10px)}}
.env.open{animation:none}
.env-back{position:absolute;inset:0;background:#e8cfa1;border-radius:6px;box-shadow:0 30px 60px rgba(0,0,0,.55);z-index:1}
.letter{
  position:absolute;left:6%;right:6%;top:6%;bottom:4%;
  background:var(--ivory);
  border:1px solid var(--gold);
  border-radius:4px;
  z-index:2;
  display:grid;place-items:center;text-align:center;
  color:var(--deep);
  transition:transform 1.1s cubic-bezier(.3,.8,.2,1) .75s;
}
.letter::before{content:"";position:absolute;inset:6px;border:1px solid rgba(212,175,95,.6)}
.letter span{font-family:var(--script);font-size:clamp(2rem,9vw,2.8rem);line-height:1.1}
.letter small{display:block;font-family:var(--body);font-size:.72rem;letter-spacing:.3em;margin-top:.4rem;color:var(--teal)}
.env.open .letter{transform:translateY(-62%)}
.pocket{position:absolute;inset:0;z-index:3;pointer-events:none}
.pocket i{position:absolute;inset:0;border-radius:6px}
.pocket .l{background:linear-gradient(120deg,#f2dfb8,#dfc088);clip-path:polygon(0 0,52% 52%,0 100%)}
.pocket .r{background:linear-gradient(240deg,#f2dfb8,#dfc088);clip-path:polygon(100% 0,48% 52%,100% 100%)}
.pocket .b{background:linear-gradient(0deg,#e6cb94,#f3e2bd);clip-path:polygon(0 100%,50% 46%,100% 100%)}
.flap{
  position:absolute;left:0;right:0;top:0;height:56%;
  z-index:4;transform-origin:top center;
  background:linear-gradient(180deg,#f6e7c3,#e3c88f);
  clip-path:polygon(0 0,100% 0,50% 100%);
  border-radius:6px 6px 0 0;
  transition:transform .85s cubic-bezier(.5,0,.2,1),z-index 0s .42s;
}
.env.open .flap{transform:rotateX(180deg);z-index:1}
.seal{
  position:absolute;left:50%;top:56%;z-index:5;
  width:68px;height:68px;margin:-34px 0 0 -34px;
  border-radius:50%;border:0;cursor:pointer;
  background:radial-gradient(circle at 35% 30%,#f5dc92,#b98a2a 70%,#8b6317);
  color:#4a3206;
  font-family:var(--script);font-size:1.7rem;line-height:1;
  box-shadow:0 6px 14px rgba(0,0,0,.5),inset 0 0 0 3px rgba(255,255,255,.18),inset 0 0 0 6px rgba(120,80,10,.25);
  animation:pulse 2.2s ease-in-out infinite;
  transition:transform .5s cubic-bezier(.5,-.6,.5,1.6),opacity .4s;
}
@keyframes pulse{
  0%,100%{box-shadow:0 6px 14px rgba(0,0,0,.5),0 0 0 0 rgba(242,220,155,.55),inset 0 0 0 3px rgba(255,255,255,.18)}
  50%{box-shadow:0 6px 14px rgba(0,0,0,.5),0 0 0 16px rgba(242,220,155,0),inset 0 0 0 3px rgba(255,255,255,.18)}
}
.env.open .seal{transform:scale(0) rotate(200deg);opacity:0;animation:none}
.tap{
  font-family:var(--display);letter-spacing:.35em;font-size:.85rem;color:var(--gold2);
  animation:blink 2.2s ease-in-out infinite;transition:opacity .4s;
}
@keyframes blink{50%{opacity:.35}}
.env-wrap.open-state .tap{opacity:0;animation:none}

/* ============ SHARED BACKDROP ============ */
#petals{position:fixed;inset:0;z-index:50;pointer-events:none}
.sparkle{
  position:fixed;z-index:60;pointer-events:none;width:10px;height:10px;
  background:var(--gold2);
  clip-path:polygon(50% 0,62% 38%,100% 50%,62% 62%,50% 100%,38% 62%,0 50%,38% 38%);
  animation:spark .9s ease-out forwards;
}
@keyframes spark{
  from{transform:translate(0,0) scale(1) rotate(0);opacity:1}
  to{transform:translate(var(--dx),var(--dy)) scale(0) rotate(120deg);opacity:0}
}

/* ============ HERO ============ */
.hero{
  position:relative;min-height:100vh;min-height:100svh;
  display:grid;place-items:center;text-align:center;
  padding:6rem 1.5rem 5rem;
  overflow:hidden;
  background:
    radial-gradient(ellipse at 50% 35%,#127067 0%,#0a413c 38%,#062b28 78%);
}
.stars{position:absolute;inset:0}
.stars b{
  position:absolute;width:2px;height:2px;border-radius:50%;background:var(--gold2);
  animation:tw var(--t,3s) ease-in-out infinite var(--dl,0s);opacity:.2;
}
@keyframes tw{50%{opacity:1;transform:scale(1.8)}}
.mandala{
  position:absolute;left:50%;top:50%;
  width:min(150vmin,1100px);aspect-ratio:1;
  margin:calc(min(150vmin,1100px)/-2) 0 0 calc(min(150vmin,1100px)/-2);
  opacity:0;transition:opacity 3s ease 1s;
  will-change:transform;
}
.mandala svg{width:100%;height:100%;overflow:visible}
.mandala .ring{transform-origin:0 0;animation:spin var(--s,120s) linear infinite}
.mandala .ring.rev{animation-direction:reverse}
@keyframes spin{to{transform:rotate(360deg)}}
body.started .mandala{opacity:.55}
.hero-inner{position:relative;z-index:2;max-width:900px}
.kicker{
  font-family:var(--display);font-size:clamp(.9rem,2.6vw,1.15rem);
  letter-spacing:.45em;color:var(--gold2);
  opacity:0;transform:translateY(14px);
}
.names{
  font-family:var(--script);font-weight:400;
  font-size:clamp(4.2rem,17vw,10.5rem);
  line-height:1.02;color:var(--ivory);
  text-shadow:0 0 40px rgba(242,220,155,.28);
  margin:1.2rem 0 .6rem;
}
.names .row{display:block}
.names .weds{
  display:block;font-family:var(--display);
  font-size:clamp(1rem,3.4vw,1.6rem);letter-spacing:.6em;
  color:var(--gold);margin:.2rem 0 .1rem;padding-left:.6em;
}
.ch{display:inline-block;opacity:0;transform:translateY(46px) rotate(7deg) scale(.9);filter:blur(10px)}
.go .ch{animation:chIn 1.3s cubic-bezier(.2,.85,.2,1) forwards;animation-delay:calc(var(--d,0ms) + var(--i)*85ms)}
@keyframes chIn{to{opacity:1;transform:none;filter:blur(0)}}
.go .kicker{animation:rise 1.2s ease .3s forwards}
@keyframes rise{to{opacity:1;transform:none}}
.flourish{width:min(320px,70vw);height:24px;margin:1.2rem auto}
.flourish path{stroke:var(--gold);fill:none;stroke-width:1.2;stroke-dasharray:500;stroke-dashoffset:500}
.go .flourish path{animation:draw 2.4s ease 2.4s forwards}
@keyframes draw{to{stroke-dashoffset:0}}
.hero-date{
  font-family:var(--display);font-size:clamp(1.2rem,4vw,1.9rem);letter-spacing:.3em;
  opacity:0;
}
.go .hero-date{animation:rise 1.2s ease 3s forwards}
.hero-place{
  margin-top:.4rem;opacity:0;letter-spacing:.2em;font-size:.95rem;color:var(--blush);
}
.go .hero-place{animation:rise 1.2s ease 3.3s forwards}
.scroll{
  position:absolute;bottom:1.6rem;left:50%;transform:translateX(-50%);
  z-index:2;width:26px;height:44px;border:1px solid var(--gold);border-radius:14px;
  opacity:0;
}
.go .scroll{animation:rise 1s ease 4s forwards}
.scroll::after{
  content:"";position:absolute;left:50%;top:8px;width:4px;height:8px;margin-left:-2px;
  background:var(--gold2);border-radius:2px;animation:wheel 1.8s ease-in-out infinite;
}
@keyframes wheel{0%{opacity:0;transform:translateY(0)}30%{opacity:1}100%{opacity:0;transform:translateY(16px)}}

/* ============ SECTIONS ============ */
section{position:relative}
.wrap{max-width:820px;margin:0 auto;padding:7rem 1.5rem}
.invite{
  background:linear-gradient(180deg,#062b28,#0a3a36);
  text-align:center;
}
.invite p.lead{
  font-family:var(--display);
  font-size:clamp(1.5rem,4.8vw,2.4rem);
  line-height:1.5;color:var(--ivory);
}
.invite p.lead em{font-style:normal;color:var(--gold2)}
.invite p.sub{margin-top:1.6rem;color:var(--blush);max-width:34rem;margin-inline:auto;font-size:1.05rem}
.line-draw{
  display:block;width:1px;height:90px;margin:0 auto 3rem;
  background:linear-gradient(var(--gold),transparent);
  transform:scaleY(0);transform-origin:top;transition:transform 1.4s ease;
}
.in .line-draw,.line-draw.in{transform:scaleY(1)}
.mask{display:block;overflow:hidden}
.mask>span{display:block;transform:translateY(110%);transition:transform 1.2s cubic-bezier(.2,.8,.2,1)}
.in .mask>span{transform:none}
.in .mask:nth-child(2)>span{transition-delay:.15s}
.in .mask:nth-child(3)>span{transition-delay:.3s}

.details{
  background:var(--ivory);color:var(--deep);
  text-align:center;overflow:hidden;
}
.details::before{
  content:"";position:absolute;inset:0;
  background:
    radial-gradient(circle at 12% 18%,rgba(212,175,95,.22),transparent 40%),
    radial-gradient(circle at 90% 85%,rgba(243,214,204,.9),transparent 45%);
}
.details .wrap{position:relative}
.details h2{
  font-family:var(--script);font-weight:400;
  font-size:clamp(3rem,10vw,5.2rem);color:var(--teal);line-height:1.1;margin-bottom:3rem;
}
.cards{display:grid;gap:1.4rem;grid-template-columns:1fr 1fr}
@media(max-width:640px){.cards{grid-template-columns:1fr}}
.card{
  position:relative;
  padding:2.6rem 1.4rem 2.4rem;
  background:#fffaf2;
  border:1px solid rgba(212,175,95,.75);
  transform:perspective(900px) rotateX(-70deg);transform-origin:top;opacity:0;
  transition:transform 1.2s cubic-bezier(.2,.8,.2,1),opacity .8s ease;
}
.card:nth-child(2){transition-delay:.25s}
.in .card{transform:none;opacity:1}
.card::before{content:"";position:absolute;inset:7px;border:1px solid rgba(212,175,95,.4);pointer-events:none}
.card h3{font-family:var(--display);font-weight:400;letter-spacing:.35em;font-size:.85rem;color:var(--gold);margin-bottom:1rem;padding-left:.35em}
.card .big{font-family:var(--display);font-size:clamp(1.7rem,5vw,2.3rem);line-height:1.2;color:var(--deep)}
.card .small{margin-top:.5rem;color:var(--teal);font-size:1rem}
.actions{margin-top:3rem;display:flex;gap:1rem;justify-content:center;flex-wrap:wrap}
.btn{
  position:relative;overflow:hidden;
  display:inline-block;text-decoration:none;cursor:pointer;
  padding:.95rem 2rem;font:400 .9rem/1 var(--body);letter-spacing:.18em;
  color:var(--deep);background:transparent;
  border:1px solid var(--gold);border-radius:999px;
  transition:color .4s ease,transform .3s ease;
  z-index:0;
}
.btn::before{
  content:"";position:absolute;inset:0;z-index:-1;
  background:var(--deep);transform:translateY(101%);
  border-radius:inherit;transition:transform .45s cubic-bezier(.3,.8,.2,1);
}
.btn:hover,.btn:focus-visible{color:var(--gold2);transform:translateY(-2px)}
.btn:hover::before,.btn:focus-visible::before{transform:none}
.btn.solid{background:var(--deep);color:var(--gold2)}
.btn.solid::before{background:var(--gold)}
.btn.solid:hover,.btn.solid:focus-visible{color:var(--deep)}

.count{
  background:radial-gradient(ellipse at 50% 0%,#11615a,#062b28 70%);
  text-align:center;
}
.count h2{font-family:var(--display);font-weight:400;font-size:clamp(1.1rem,3.4vw,1.5rem);letter-spacing:.35em;color:var(--gold2);margin-bottom:2.5rem;padding-left:.35em}
.timer{display:flex;justify-content:center;gap:clamp(.6rem,3vw,1.8rem)}
.unit{
  min-width:clamp(64px,19vw,120px);
  padding:1.3rem .4rem 1rem;
  border:1px solid rgba(212,175,95,.5);border-radius:50% 50% 8px 8px / 38% 38% 8px 8px;
  background:linear-gradient(180deg,rgba(255,255,255,.07),rgba(255,255,255,.01));
}
.unit b{display:block;font-family:var(--display);font-weight:400;font-size:clamp(2rem,9vw,3.6rem);line-height:1;color:var(--ivory)}
.unit b.bump{animation:bump .5s ease}
@keyframes bump{40%{transform:translateY(-6px);color:var(--gold2)}}
.unit span{display:block;margin-top:.5rem;font-size:.72rem;letter-spacing:.25em;color:var(--blush);padding-left:.25em}
.note{margin-top:2.6rem;color:var(--blush)}

footer{
  text-align:center;background:#041f1d;
  padding:6rem 1.5rem 5rem;position:relative;overflow:hidden;
}
footer .thanks{font-family:var(--script);font-size:clamp(2.2rem,8vw,3.6rem);color:var(--gold2);line-height:1.2}
footer .with{margin:1rem 0 2.2rem;color:var(--blush)}
footer .sig{margin-top:3rem;font-family:var(--display);letter-spacing:.4em;font-size:.85rem;color:var(--gold);padding-left:.4em}
footer .btn{color:var(--gold2)}
footer .btn::before{background:var(--gold)}
footer .btn:hover,footer .btn:focus-visible{color:var(--deep)}

@media (prefers-reduced-motion:reduce){
  *,*::before,*::after{animation-duration:.01ms!important;animation-iteration-count:1!important;transition-duration:.01ms!important;transition-delay:0s!important}
  .ch,.kicker,.hero-date,.hero-place,.scroll{opacity:1!important;transform:none!important;filter:none!important}
  .flourish path{stroke-dashoffset:0}
  .mask>span,.card{transform:none!important;opacity:1!important}
  .line-draw{transform:none}
}
</style>
</head>
<body class="locked">

<!-- ENVELOPE INTRO -->
<div id="intro" role="dialog" aria-label="Wedding invitation envelope">
  <div class="glow"></div>
  <div class="env-wrap" id="envWrap">
    <div class="env" id="env">
      <div class="env-back"></div>
      <div class="letter"><div><span>Risheen &amp; Dilshad</span><small>5 . 1 . 2027</small></div></div>
      <div class="pocket"><i class="l"></i><i class="r"></i><i class="b"></i></div>
      <div class="flap"></div>
      <button class="seal" id="seal" aria-label="Open the invitation">R&amp;D</button>
    </div>
    <div class="tap">TAP THE SEAL TO OPEN</div>
  </div>
</div>

<canvas id="petals" aria-hidden="true"></canvas>

<main>
  <!-- HERO -->
  <header class="hero" id="hero">
    <div class="stars" id="stars" aria-hidden="true"></div>
    <div class="mandala" id="mandala" aria-hidden="true"></div>
    <div class="hero-inner">
      <p class="kicker">YOU ARE INVITED</p>
      <h1 class="names" aria-label="Risheen weds Dilshad">
        <span class="row" id="n1" aria-hidden="true">Risheen</span>
        <span class="weds" aria-hidden="true">WEDS</span>
        <span class="row" id="n2" aria-hidden="true">Dilshad</span>
      </h1>
      <svg class="flourish" viewBox="0 0 320 24" aria-hidden="true">
        <path d="M2 12 H128 M192 12 H318 M160 4 C150 4 144 10 144 12 C144 14 150 20 160 20 C170 20 176 14 176 12 C176 10 170 4 160 4 Z M144 12 C136 6 132 6 128 12 C132 18 136 18 144 12 M176 12 C184 6 188 6 192 12 C188 18 184 18 176 12"/>
      </svg>
      <p class="hero-date">5 JANUARY 2027</p>
      <p class="hero-place">Rajah Hall, Chavakkad</p>
    </div>
    <div class="scroll" aria-hidden="true"></div>
  </header>

  <!-- MESSAGE -->
  <section class="invite reveal">
    <div class="wrap">
      <span class="line-draw"></span>
      <p class="lead">
        <span class="mask"><span>With the blessings of our families,</span></span>
        <span class="mask"><span>we joyfully invite you to share</span></span>
        <span class="mask"><span>the beginning of <em>our forever.</em></span></span>
      </p>
      <p class="sub">Your presence and prayers will make our wedding day truly complete.</p>
    </div>
  </section>

  <!-- DETAILS -->
  <section class="details reveal" id="details">
    <div class="wrap">
      <h2>Save the date</h2>
      <div class="cards">
        <article class="card">
          <h3>DATE</h3>
          <p class="big">Tuesday<br>5 January 2027</p>
          <p class="small">Please join us for the celebration</p>
        </article>
        <article class="card">
          <h3>VENUE</h3>
          <p class="big">Rajah Hall<br>Chavakkad</p>
          <p class="small">Thrissur, Kerala</p>
        </article>
      </div>
      <div class="actions">
        <a class="btn solid" target="_blank" rel="noopener" href="https://www.google.com/maps/search/?api=1&query=Rajah+Hall+Chavakkad">VIEW MAP</a>
        <button class="btn" id="cal" type="button">ADD TO CALENDAR</button>
      </div>
    </div>
  </section>

  <!-- COUNTDOWN -->
  <section class="count reveal" id="count">
    <div class="wrap">
      <h2>COUNTING DOWN TO OUR DAY</h2>
      <div class="timer" role="timer" aria-live="off">
        <div class="unit"><b id="d">00</b><span>DAYS</span></div>
        <div class="unit"><b id="h">00</b><span>HOURS</span></div>
        <div class="unit"><b id="m">00</b><span>MINUTES</span></div>
        <div class="unit"><b id="s">00</b><span>SECONDS</span></div>
      </div>
      <p class="note" id="note"></p>
    </div>
  </section>
</main>

<footer>
  <p class="thanks">We can't wait to celebrate with you</p>
  <p class="with">Share the invitation with someone who should be there.</p>
  <a class="btn" id="wa" target="_blank" rel="noopener" href="#">SHARE ON WHATSAPP</a>
  <p class="sig">RISHEEN &amp; DILSHAD</p>
</footer>

<script>
(function(){
  var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  var body = document.body;

  /* ---------- Split names into letters ---------- */
  function split(el, delay){
    var t = el.textContent; el.textContent = '';
    t.split('').forEach(function(c,i){
      var s = document.createElement('span');
      s.className = 'ch'; s.textContent = c;
      s.style.setProperty('--i', i); s.style.setProperty('--d', delay+'ms');
      el.appendChild(s);
    });
  }
  split(document.getElementById('n1'), 700);
  split(document.getElementById('n2'), 1700);

  /* ---------- Stars ---------- */
  var stars = document.getElementById('stars');
  for(var i=0;i<80;i++){
    var b=document.createElement('b');
    b.style.left=Math.random()*100+'%';
    b.style.top=Math.random()*100+'%';
    b.style.setProperty('--t',(2+Math.random()*4)+'s');
    b.style.setProperty('--dl',(Math.random()*4)+'s');
    stars.appendChild(b);
  }

  /* ---------- Mandala ---------- */
  (function(){
    var NS='http://www.w3.org/2000/svg';
    var svg=document.createElementNS(NS,'svg');
    svg.setAttribute('viewBox','-300 -300 600 600');
    function petalPath(len,w){
      return 'M0 0 C '+w+' '+(-len*.35)+' '+w+' '+(-len*.7)+' 0 '+(-len)+' C '+(-w)+' '+(-len*.7)+' '+(-w)+' '+(-len*.35)+' 0 0Z';
    }
    var layers=[
      {n:24,len:290,w:26,sw:.7,s:160,rev:false,op:.55},
      {n:16,len:215,w:30,sw:.9,s:110,rev:true,op:.7},
      {n:12,len:150,w:26,sw:1,s:80,rev:false,op:.85},
      {n:8,len:92,w:20,sw:1.1,s:60,rev:true,op:1}
    ];
    layers.forEach(function(L){
      var g=document.createElementNS(NS,'g');
      g.setAttribute('class','ring'+(L.rev?' rev':''));
      g.style.setProperty('--s',L.s+'s');
      g.setAttribute('opacity',L.op);
      for(var i=0;i<L.n;i++){
        var p=document.createElementNS(NS,'path');
        p.setAttribute('d',petalPath(L.len,L.w));
        p.setAttribute('fill','none');
        p.setAttribute('stroke','#d4af5f');
        p.setAttribute('stroke-width',L.sw);
        p.setAttribute('transform','rotate('+(i*360/L.n)+')');
        g.appendChild(p);
      }
      svg.appendChild(g);
    });
    [60,300].forEach(function(r){
      var c=document.createElementNS(NS,'circle');
      c.setAttribute('r',r);c.setAttribute('fill','none');
      c.setAttribute('stroke','#d4af5f');c.setAttribute('stroke-width','.6');
      c.setAttribute('opacity','.5');svg.appendChild(c);
    });
    document.getElementById('mandala').appendChild(svg);
  })();

  /* ---------- Parallax on mandala ---------- */
  var mand=document.getElementById('mandala'), ticking=false;
  window.addEventListener('scroll',function(){
    if(ticking||reduce) return; ticking=true;
    requestAnimationFrame(function(){
      var y=window.scrollY;
      mand.style.transform='translateY('+(y*.25)+'px) scale('+(1+y/3000)+')';
      ticking=false;
    });
  },{passive:true});

  /* ---------- Envelope open ---------- */
  var env=document.getElementById('env'),
      wrap=document.getElementById('envWrap'),
      intro=document.getElementById('intro'),
      seal=document.getElementById('seal'), opened=false;
  function openInvite(){
    if(opened) return; opened=true;
    env.classList.add('open'); wrap.classList.add('open-state');
    burst(window.innerWidth/2, window.innerHeight/2, 26);
    setTimeout(function(){
      intro.classList.add('done');
      body.classList.remove('locked');
      body.classList.add('started');
      document.getElementById('hero').classList.add('go');
      startPetals();
    }, reduce?200:2500);
  }
  seal.addEventListener('click',openInvite);
  env.addEventListener('click',openInvite);

  /* ---------- Sparkles ---------- */
  function burst(x,y,n){
    if(reduce) return;
    for(var i=0;i<n;i++){
      var s=document.createElement('i');
      s.className='sparkle';
      var a=Math.random()*Math.PI*2, d=60+Math.random()*120;
      s.style.left=x+'px'; s.style.top=y+'px';
      s.style.setProperty('--dx',Math.cos(a)*d+'px');
      s.style.setProperty('--dy',Math.sin(a)*d+'px');
      var sz=6+Math.random()*10; s.style.width=s.style.height=sz+'px';
      document.body.appendChild(s);
      setTimeout(function(el){el.remove()},1000,s);
    }
  }
  var lastSpark=0;
  window.addEventListener('pointermove',function(e){
    if(reduce||!opened) return;
    var now=Date.now(); if(now-lastSpark<70) return; lastSpark=now;
    burst(e.clientX,e.clientY,1);
  },{passive:true});
  window.addEventListener('pointerdown',function(e){ if(opened) burst(e.clientX,e.clientY,12); });

  /* ---------- Falling petals (canvas) ---------- */
  var cv=document.getElementById('petals'), ctx=cv.getContext('2d'), P=[], running=false, W,H;
  function size(){
    var dpr=Math.min(window.devicePixelRatio||1,2);
    W=cv.width=innerWidth*dpr; H=cv.height=innerHeight*dpr;
    cv.style.width=innerWidth+'px'; cv.style.height=innerHeight+'px';
    ctx.setTransform(1,0,0,1,0,0); ctx.scale(dpr,dpr);
  }
  size(); addEventListener('resize',size);
  var colors=['#f3d6cc','#f7e3dc','#d4af5f','#f2dc9b','#ffffff'];
  function mk(top){
    return {
      x:Math.random()*innerWidth,
      y:top?-20-Math.random()*innerHeight*.5:Math.random()*innerHeight,
      r:5+Math.random()*8,
      vy:.5+Math.random()*1.1,
      sw:Math.random()*Math.PI*2,
      sws:.01+Math.random()*.02,
      amp:.4+Math.random()*1,
      rot:Math.random()*Math.PI*2,
      rots:(Math.random()-.5)*.04,
      c:colors[(Math.random()*colors.length)|0],
      a:.35+Math.random()*.5
    };
  }
  function startPetals(){
    if(running||reduce) return; running=true;
    var count=innerWidth<640?22:42;
    for(var i=0;i<count;i++) P.push(mk(false));
    (function loop(){
      ctx.clearRect(0,0,innerWidth,innerHeight);
      for(var i=0;i<P.length;i++){
        var p=P[i];
        p.sw+=p.sws; p.x+=Math.sin(p.sw)*p.amp; p.y+=p.vy; p.rot+=p.rots;
        if(p.y>innerHeight+20) P[i]=mk(true);
        ctx.save();
        ctx.translate(p.x,p.y); ctx.rotate(p.rot);
        ctx.scale(1,.45+Math.abs(Math.sin(p.sw))*.55);
        ctx.globalAlpha=p.a; ctx.fillStyle=p.c;
        ctx.beginPath();
        ctx.moveTo(0,-p.r);
        ctx.bezierCurveTo(p.r,-p.r*.6,p.r*.8,p.r*.7,0,p.r);
        ctx.bezierCurveTo(-p.r*.8,p.r*.7,-p.r,-p.r*.6,0,-p.r);
        ctx.fill(); ctx.restore();
      }
      requestAnimationFrame(loop);
    })();
  }

  /* ---------- Scroll reveals ---------- */
  var io=new IntersectionObserver(function(es){
    es.forEach(function(e){ if(e.isIntersecting){ e.target.classList.add('in'); io.unobserve(e.target);} });
  },{threshold:.25});
  document.querySelectorAll('.reveal').forEach(function(el){io.observe(el)});

  /* ---------- Countdown ---------- */
  var target=new Date('2027-01-05T00:00:00+05:30').getTime();
  var els={d:document.getElementById('d'),h:document.getElementById('h'),m:document.getElementById('m'),s:document.getElementById('s')};
  var prev={};
  function pad(n){return String(n).padStart(2,'0')}
  function tick(){
    var diff=target-Date.now();
    var note=document.getElementById('note');
    if(diff<=0){
      var over=Date.now()-target < 864e5;
      note.textContent=over?'Today is the day. Welcome!':'Thank you for celebrating with us.';
      ['d','h','m','s'].forEach(function(k){els[k].textContent='00'}); return;
    }
    var v={
      d:Math.floor(diff/864e5),
      h:Math.floor(diff%864e5/36e5),
      m:Math.floor(diff%36e5/6e4),
      s:Math.floor(diff%6e4/1e3)
    };
    for(var k in v){
      var t=pad(v[k]);
      if(prev[k]!==t){
        els[k].textContent=t;
        if(prev[k]!==undefined && !reduce){ els[k].classList.remove('bump'); void els[k].offsetWidth; els[k].classList.add('bump'); }
        prev[k]=t;
      }
    }
    note.textContent=v.d+' days until we say "I do".';
  }
  tick(); setInterval(tick,1000);

  /* ---------- Add to calendar (.ics) ---------- */
  document.getElementById('cal').addEventListener('click',function(){
    var ics=[
      'BEGIN:VCALENDAR','VERSION:2.0','PRODID:-//Risheen and Dilshad//Wedding//EN',
      'BEGIN:VEVENT',
      'UID:risheen-dilshad-20270105@invitation',
      'DTSTAMP:20261112T000000Z',
      'DTSTART;VALUE=DATE:20270105',
      'DTEND;VALUE=DATE:20270106',
      'SUMMARY:Risheen weds Dilshad',
      'LOCATION:Rajah Hall\\, Chavakkad\\, Kerala',
      'DESCRIPTION:You are invited to the wedding of Risheen and Dilshad.',
      'END:VEVENT','END:VCALENDAR'
    ].join('\r\n');
    var blob=new Blob([ics],{type:'text/calendar'});
    var a=document.createElement('a');
    a.href=URL.createObjectURL(blob); a.download='risheen-weds-dilshad.ics';
    document.body.appendChild(a); a.click(); a.remove();
  });

  /* ---------- WhatsApp share ---------- */
  var msg='You are invited! Risheen weds Dilshad on 5 January 2027 at Rajah Hall, Chavakkad. '+location.href;
  document.getElementById('wa').href='https://wa.me/?text='+encodeURIComponent(msg);
})();
</script>
